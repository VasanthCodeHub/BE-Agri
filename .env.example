# ===========================================================================
# LOCAL TEMPLATE  (development + testing)
#
# Copy this to `.env` and fill in real values:
#     Copy-Item .env.example .env
#
# `.env` is git-ignored. This template is committed, so it must contain
# PLACEHOLDERS ONLY — never a real secret.
# ===========================================================================

# --- Environment -----------------------------------------------------------
APP_ENV=local
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# --- Database --------------------------------------------------------------
# Note the driver: `postgresql+asyncpg`. Plain `postgresql://` picks the
# synchronous driver and the app will refuse to start.
DATABASE_URL=postgresql+asyncpg://agri:agri_local_password@localhost:5432/agri_local
DB_ECHO=false

# --- Security --------------------------------------------------------------
# Generate your own:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_urlsafe
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- CORS ------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Integrations ----------------------------------------------------------
# "fake" needs no vendor account: the OTP is printed to your terminal so you
# can log in locally for free, with no real SMS sent.
SMS_PROVIDER=fake
# "local" writes uploads to a folder on disk instead of object storage.
STORAGE_BACKEND=local

# --- Twilio (production only) ----------------------------------------------
# Local development needs NONE of this: SMS_PROVIDER=fake prints the OTP to your
# terminal, and OTP_DEV_BYPASS_CODE logs in any number. Only production sets
# SMS_PROVIDER=twilio, and then all of the below are required at startup.
#
# We generate and verify the OTP ourselves; Twilio only delivers the SMS. So
# there is no TWILIO_VERIFY_SERVICE_SID here - that belongs to Twilio Verify,
# a different product where Twilio owns the code and the verification.
#
# Where to find each value:
#   ACCOUNT_SID / AUTH_TOKEN -> Twilio console dashboard (SID starts with "AC")
#   PHONE_NUMBER             -> Phone Numbers > Manage > Active numbers (E.164)
#
# For India, the sender also needs TRAI/DLT registration (entity + header +
# template) or the operator drops the message. SMS_OTP_TEMPLATE below must match
# the registered template exactly.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TIMEOUT_SECONDS=10

# The delivered SMS text. {code} is required, {minutes} is optional.
SMS_OTP_TEMPLATE={code} is your verification code for Agri Vehicle Rental. It expires in {minutes} minutes. Do not share it with anyone.

# --- OTP policy ------------------------------------------------------------
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_PHONE_PER_HOUR=3

# --- Development OTP bypass ------------------------------------------------
# When set, this code logs in ANY phone number (the real OTP also still works).
# Leave EMPTY in production - the app refuses to start otherwise, because this
# is a complete authentication bypass.
OTP_DEV_BYPASS_CODE=0000

# --- Search defaults -------------------------------------------------------
DEFAULT_SEARCH_RADIUS_KM=25
MAX_SEARCH_RADIUS_KM=100
